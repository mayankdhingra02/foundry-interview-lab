# Local development only. Production requires verified accounts and PostgreSQL.
AUTH_MODE=local
APP_URL=http://127.0.0.1:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
PRACTICE_DATA_PATH=./data/practice.json
DATABASE_URL=

# Optional model inference; absent key uses explicitly labelled authored questions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_INPUT_USD_PER_MILLION=0.75
OPENAI_OUTPUT_USD_PER_MILLION=4.5
AI_MAX_OUTPUT_TOKENS=2400

# Isolated execution. Never run learner code on the application host.
RUNNER_MODE=docker
PYTHON_IMAGE=python:3.11-slim
# Required before execution admission. Review/provision the image deliberately,
# inspect its local immutable ID on the execution host, and configure BOTH web
# and worker with that exact sha256:64hex value. No tag-only fallback.
PYTHON_IMAGE_ID=
RUNNER_ALLOWED_IMAGES=python:3.11-slim
RUNNER_URL=
RUNNER_AUTH_TOKEN=

# Supabase identity for hosted deployments.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional voice and commerce. Keep credentials server side.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
ADMIN_USER_IDS=
INVITED_PRACTICE_USER_IDS=

# New attempts only. Unset locally: open + all five known packages.
# Unset in production: staff + no admitted scenarios (closed by default).
# Exact comma-separated IDs; no wildcard/email/prefix matching. An explicit empty
# scenario list retires every scenario for new attempts while saved work remains.
# PRACTICE_ADMISSION_MODE=staff
# PRACTICE_ADMITTED_SCENARIOS=monetary-validation,extension-compatibility,duplicate-invoice,inventory-reservations,event-rollup

# Explicit rollout gates
FEATURE_AI_INTERVIEW=true
FEATURE_REPORT_GENERATION=false
FEATURE_EXECUTION=true
FEATURE_VOICE=false
FEATURE_BILLING=false

# Conservative provider-spend admission ceilings (USD).
MAX_SESSION_USD=1
MAX_DAILY_USER_USD=5
MAX_MONTHLY_USER_USD=50
MAX_GLOBAL_DAILY_USD=50

# Shared, persisted learner admission defaults. See docs/admission.md before
# widening these conservative limits; they are not measured hosted capacity.
# PRACTICE_OWNER_MUTATIONS_PER_MINUTE=30
# PRACTICE_OWNER_MUTATIONS_PER_DAY=1000
# PRACTICE_OWNER_SAVES_PER_MINUTE=90
# PRACTICE_OWNER_SAVES_PER_DAY=5000
# PRACTICE_MAX_OWNER_HISTORY=50
# PRACTICE_MAX_OWNER_REQUESTS=5000
# PRACTICE_MAX_SESSION_SNAPSHOTS=512
# PRACTICE_MAX_SESSION_EVENTS=3000
# PRACTICE_MAX_GLOBAL_PENDING_JOBS=20
# PRACTICE_MAX_OWNER_PENDING_JOBS=4

# Paid sessions stay disabled until all commerce settings are supplied.
STRIPE_SESSIONS_PER_PERIOD=
BILLING_FREE_SESSIONS_PER_MONTH=2

# Press-to-talk speech requires a separately qualified deployment account.
VOICE_QUALIFIED=false
VOICE_STT_USD_PER_MINUTE=0.0043
VOICE_TTS_USD_PER_1K_CHARS=0.03
VOICE_MAX_SESSION_MINUTES=20
VOICE_MAX_USER_DAILY_MINUTES=60
VOICE_MAX_GLOBAL_DAILY_MINUTES=600
VOICE_MAX_GLOBAL_DAILY_USD=50
